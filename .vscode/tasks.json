{
    "tasks": [
        {
            "type": "shell",
            "label": "Build All C Files in Folder",
            "command": "gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "*.c",
                "-o",
                "${fileDirname}\\main.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Kompiliert alle .c Dateien im aktuellen Verzeichnis"
        }
    ],
    "version": "2.0.0"
}